{{- $role := get . "role" | default "desktop" -}}
[settings]
{{ if ne $role "headless" -}}
trusted_config_paths = ["~/Projects"]
{{ end -}}
# The agent CLIs cut several releases a week and we track them deliberately,
# so the release-age hold just keeps `mise up` a version behind on all four.
# Every other tool keeps the delay.
minimum_release_age_excludes = ["claude", "codex", "opencode", "pi"]

[tools]
# Agent CLIs. mise is their single version owner on every role: the registry
# ships native binaries (aqua/github), so no node install can take them away
# and none of them needs one. `mise up` is the update route; a tool's own
# `update`/`upgrade` subcommand writes a second copy mise cannot see.
claude = "latest"
# The registry installs only the primary Codex binary. Restore the companion
# host and sandbox resources from the matching official package after every
# install or upgrade.
codex = { version = "latest", postinstall = "{{ .chezmoi.homeDir }}/.local/bin/codex-install-runtime" }
opencode = "latest"
pi = "latest"
fnox = "latest"
go = "latest"
node = "latest"
uv = "0.11.20"
"github:basecamp/hey-cli" = "latest"
{{- if eq $role "headless" }}
# Headless-only: omarchy provides these via pacman; the omaterm containers
# get them through mise. glab is pinned because the sagan release tasks call
# it through mise shims, which fail on an unpinned tool.
chezmoi = "latest"
git-lfs = "latest"
glab = "1.108.0"
worktrunk = "latest"
{{- end }}
