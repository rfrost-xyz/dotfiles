{{/* Managed as a template: the theme is role-dependent (omarchy exists only
on the desktop). Edit this file directly — never `chezmoi add`/`re-add` the
live settings.json, that would strip the templating. */ -}}
{
  "lastChangelogVersion": "0.84.3",
  "theme": {{ if eq (get . "role" | default "desktop") "headless" }}"dark"{{ else }}"omarchy"{{ end }},
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "anthropic/claude-opus-5",
    "anthropic/claude-fable-5"
  ],
  "packages": [
    "npm:pi-rewind",
    "npm:pi-insights",
    "npm:@carter-mcalister/pi-worktrunk"
  ],
  "editorPaddingX": 0,
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "default",
  "skills": [
    "~/.agents/skills"
  ],
  "hideThinkingBlock": false,
  "autocompleteMaxVisible": 7,
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "compaction": {
    "enabled": true
  },
  "showHardwareCursor": true,
  "images": {
    "blockImages": true
  },
  "steeringMode": "one-at-a-time",
  "warnings": {
    "anthropicExtraUsage": false
  }
}