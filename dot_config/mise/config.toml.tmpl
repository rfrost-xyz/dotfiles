{{- $role := get . "role" | default "desktop" -}}
{{- if ne $role "headless" -}}
[settings]
trusted_config_paths = ["~/Projects"]

{{ end -}}
[tools]
# Agent CLIs. mise is their single version owner on every role: the registry
# ships native binaries (aqua/github), so no node install can take them away
# and none of them needs one. `mise up` is the update route; a tool's own
# `update`/`upgrade` subcommand writes a second copy mise cannot see.
claude = "latest"
codex = "latest"
opencode = "latest"
pi = "latest"
fnox = "latest"
go = "latest"
node = "latest"
uv = "0.11.20"
{{- if eq $role "headless" }}
# Headless-only: omarchy provides these via pacman; the omaterm containers
# get them through mise. glab is pinned because the sagan release tasks call
# it through mise shims, which fail on an unpinned tool.
chezmoi = "latest"
git-lfs = "latest"
glab = "1.108.0"
worktrunk = "latest"
{{- end }}
